# Settings of one region (cell) of the LifeOS backend. No secrets here: `./gen-env.sh > .env` copies this file and
# fills the empty secret values with fresh random ones. Never commit a filled env file — keep it in a password manager.
# Values are plain KEY=VALUE (no spaces around =, no shell expansion).
# (Named env.example, not .env.example: agents of this repo may not open `.env*` files at all.)

########## Region ##########
# kz — production in Kazakhstan (data stays in the RK, law No. 94-V); eu — staging with synthetic data only.
# The Docker project is lifeos-<REGION>, so two regions can run side by side on one host.
REGION=kz

########## Addresses ##########
# Public URL of the API (the TLS reverse proxy in front of Kong). The app gets it as VITE_SUPABASE_URL_<REGION>.
SUPABASE_PUBLIC_URL=http://localhost:8000
API_EXTERNAL_URL=http://localhost:8000/auth/v1
# Where magic links and e-mail confirmations send the user back.
SITE_URL=http://localhost:5173
ADDITIONAL_REDIRECT_URLS=
# Kong listens on KONG_BIND:KONG_HTTP_PORT. Keep 127.0.0.1 behind a reverse proxy; Postgres is never published.
KONG_BIND=127.0.0.1
KONG_HTTP_PORT=8000
# Studio (opt-in profile `studio`) is published on 127.0.0.1 only — open it through an SSH tunnel.
STUDIO_PORT=3000

########## HTTPS reverse proxy (profile `proxy`, deploy-remote.sh turns it on) ##########
# Compose profiles to start besides the stack: `proxy` on a server deployed by the «Deploy KZ» workflow.
COMPOSE_PROFILES=
# Domain of the API (SUPABASE_PUBLIC_URL without https://); Caddy gets its Let's Encrypt certificate.
API_DOMAIN=
# Contact e-mail for Let's Encrypt (deploy-remote.sh uses SMTP_ADMIN_EMAIL).
ACME_EMAIL=
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443

########## Auth ##########
JWT_EXPIRY=3600
DISABLE_SIGNUP=false
# true only for tests: users are confirmed without an e-mail.
ENABLE_EMAIL_AUTOCONFIRM=false
# SMTP for magic links (a free tier of an SMTP provider, ADR-0009). SMTP_PASS is a secret: set it on the server only.
SMTP_ADMIN_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=LifeOS

########## Secrets (filled by gen-env.sh) ##########
POSTGRES_PASSWORD=
JWT_SECRET=
# JWTs signed with JWT_SECRET: ANON_KEY goes to the app, SERVICE_ROLE_KEY never leaves the server.
ANON_KEY=
SERVICE_ROLE_KEY=
PG_META_CRYPTO_KEY=

########## Backups (backup.sh, restore.sh) ##########
# Any S3-compatible storage in the region's jurisdiction; for kz — Yandex Object Storage kz1
# (S3_ENDPOINT=https://storage.yandexcloud.kz, S3_REGION=kz1). The keys are secrets: set them on the server only.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_PREFIX=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BACKUP_KEEP=14
# Copies are encrypted with this key before upload (filled by gen-env.sh). Keep it in the password manager apart from
# the bucket keys: without it no copy can be restored, with the bucket keys alone nothing can be read.
BACKUP_ENCRYPTION_KEY=

########## Alerts (healthcheck.sh) ##########
# POST {"text": "…"} goes here (Slack/Mattermost incoming webhook, or Telegram:
# https://api.telegram.org/bot<token>/sendMessage?chat_id=<chat>). A secret: set it on the server only.
ALERT_WEBHOOK_URL=
# Alert when a disk holding one of DISK_PATHS is at least this full (percent).
DISK_ALERT_PERCENT=85
DISK_PATHS=/ /var/lib/docker
